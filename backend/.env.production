NODE_ENV=production
PORT=5000

MONGODB_URI=mongodb://username:password@mongodb:27017/ecommerce?authSource=admin
REDIS_URL=redis://redis:6379

SESSION_SECRET=your_production_session_secret_min_32_characters_long

JWT_ACCESS_SECRET=your_production_jwt_access_secret
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

EMAIL_HOST=smtp.yourdomain.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=noreply@yourdomain.com
EMAIL_PASS=your_email_password
EMAIL_FROM="Your Store <noreply@yourdomain.com>"

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

CLIENT_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

ENCRYPTION_KEY=your_32_byte_encryption_key_for_sensitive_data

LOG_LEVEL=info
